{
    "include": [
        "src/**/*",
        "tests/**/*",
        "scripts/**/*",
        "*.config.ts"
    ],
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2022", "dom"],
        "types": ["node"],
        "strict": true,
        "useUnknownInCatchVariables": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true
    }
}
