{
    "name": "neffos.js",
    "version": "0.2.0",
    "description": "javascript client for the modern neffos websocket framework",
    "keywords": [
        "neffos",
        "realtime",
        "framework",
        "websocket",
        "events",
        "iris",
        "iris web framework"
    ],
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=22"
    },
    "main": "./dist/neffos.cjs",
    "module": "./dist/neffos.js",
    "types": "./dist/neffos.d.ts",
    "browser": "./dist/neffos.browser.js",
    "unpkg": "./dist/neffos.global.min.js",
    "jsdelivr": "./dist/neffos.global.min.js",
    "exports": {
        ".": {
            "browser": {
                "types": "./dist/neffos.d.ts",
                "default": "./dist/neffos.browser.js"
            },
            "import": {
                "types": "./dist/neffos.d.ts",
                "default": "./dist/neffos.js"
            },
            "require": {
                "types": "./dist/neffos.d.cts",
                "default": "./dist/neffos.cjs"
            }
        },
        "./global": "./dist/neffos.global.js",
        "./global.min": "./dist/neffos.global.min.js",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "HISTORY.md"
    ],
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
        "typecheck": "tsc --project tsconfig.json",
        "lint": "eslint .",
        "test": "vitest run",
        "size": "node scripts/check-dist.mjs",
        "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run size",
        "prepublishOnly": "npm run check"
    },
    "peerDependencies": {
        "ws": ">=8.18.0"
    },
    "peerDependenciesMeta": {
        "ws": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^22.20.5",
        "@types/ws": "^8.18.2",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^9.39.5",
        "tsup": "^8.5.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^4.1.11",
        "ws": "^8.22.0"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git://github.com/kataras/neffos.js"
    },
    "bugs": {
        "url": "https://github.com/kataras/neffos.js/issues"
    },
    "author": "Gerasimos Maropoulos (@kataras)",
    "contributors": [
        {
            "name": "Gerasimos Maropoulos (@kataras)",
            "email": "kataras2006@hotmail.com"
        }
    ]
}
